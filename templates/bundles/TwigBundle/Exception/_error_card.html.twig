{#
    Page d'erreur présentée comme une carte Magic.
    Variables : code, name, cost, type, rules, flavor, stats, frame (classes du cadre), glow (classes de lueur)
    Aucune requête en base ici : la page doit s'afficher même si la base est indisponible.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ name }}{% endblock %}

{% block body %}
    <div class="flex flex-col items-center gap-10 py-4 lg:flex-row lg:justify-center lg:gap-16 lg:py-10">
        {# ---------- La carte ---------- #}
        <div class="error-card w-72 shrink-0 sm:w-80" aria-hidden="true">
            <div class="relative aspect-[63/88] rounded-[4.75%/3.5%] bg-ink-950 p-3 shadow-2xl shadow-black/70 ring-1 ring-white/10">
                <div class="flex h-full flex-col gap-1.5 rounded-[3%/2%] bg-gradient-to-b p-2 {{ frame }}">
                    <div class="flex items-center justify-between gap-2 rounded-md border border-black/40 bg-ink-100/90 px-2 py-1 text-ink-950 shadow-inner">
                        <span class="truncate font-display text-base font-bold">{{ name }}</span>
                        <span class="shrink-0">{{ cost|mana_symbols }}</span>
                    </div>

                    <div class="relative grid flex-[1.15] place-items-center overflow-hidden rounded-sm border-2 border-black/50 bg-ink-950">
                        <div class="absolute inset-0 bg-radial-[at_50%_60%] {{ glow }}"></div>
                        <div class="error-sparks absolute inset-0"></div>
                        <span class="relative font-display text-7xl font-bold tracking-wider text-white drop-shadow-[0_0_18px_rgba(255,255,255,0.55)]">{{ code }}</span>
                    </div>

                    <div class="flex items-center justify-between rounded-md border border-black/40 bg-ink-100/90 px-2 py-0.5 text-ink-950">
                        <span class="truncate font-display text-sm font-bold">{{ type }}</span>
                        <img src="https://svgs.scryfall.io/sets/default.svg" alt="" class="h-4 w-4">
                    </div>

                    <div class="flex flex-[0.9] flex-col justify-center gap-2 rounded-sm border border-black/40 bg-[#efe9dc] px-3 py-2 font-serif text-[0.8rem] leading-snug text-ink-950">
                        <p>{{ rules|mana_symbols }}</p>
                        <p class="border-t border-black/15 pt-2 italic">{{ flavor }}</p>
                    </div>

                    <div class="flex items-center justify-between px-1 text-[0.6rem] text-white/70">
                        <span>{{ site_name }} · Erreur {{ code }}</span>
                        {% if stats %}
                            <span class="rounded-md border border-black/40 bg-ink-100/90 px-2 py-0.5 font-display text-sm font-bold text-ink-950">{{ stats }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# ---------- Message ---------- #}
        <div class="max-w-md text-center lg:text-left">
            <p class="badge border-neon-violet/50 text-neon-violet">Erreur {{ code }}</p>
            <h1 class="mt-4 text-4xl uppercase sm:text-5xl">{{ headline }}</h1>
            <p class="mt-3 text-lg text-ink-300">{{ message }}</p>
            <div class="mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
                <a href="{{ path('app_home') }}" class="btn btn-primary">Retour à l'accueil</a>
                <a href="{{ path('app_card_search') }}" class="btn btn-ghost">Rechercher une carte</a>
            </div>
        </div>
    </div>
{% endblock %}
