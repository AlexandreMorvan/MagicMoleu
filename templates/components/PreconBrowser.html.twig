<div {{ attributes }}>
    <div class="flex flex-wrap items-center gap-3">
        <label for="precon-q" class="sr-only">Rechercher un deck</label>
        <input id="precon-q" type="search" class="input max-w-md" data-model="debounce(300)|q" placeholder="Deck, commandant ou édition…" autocomplete="off">
        <select class="input w-auto" data-model="year" aria-label="Année de sortie">
            <option value="">Toutes les années</option>
            {% for y in this.years %}<option value="{{ y }}" {{ y == year ? 'selected' }}>{{ y }}</option>{% endfor %}
        </select>
        <span data-loading class="h-4 w-4 animate-spin rounded-full border-2 border-neon-violet border-t-transparent" hidden></span>
    </div>

    {% set decks = this.decks %}
    {% set owned = this.ownedPercentages %}
    <div data-loading="addClass(opacity-50)" class="mt-6 transition-opacity">
        {% if decks is empty %}
            <p class="panel p-10 text-center text-ink-300">
                {{ q or year ? 'Aucun deck préconstruit ne correspond à ta recherche.' : 'Le catalogue des decks préconstruits est vide pour l\'instant.' }}
            </p>
        {% else %}
            {% for deck_year, year_decks in this.decksByYear %}
                <section class="{{ loop.first ? '' : 'mt-10' }}">
                    <h2 class="mb-3 flex items-baseline gap-2 text-xl uppercase text-ink-300">{{ deck_year }} <span class="text-sm text-ink-500">({{ year_decks|length }}{{ loop.last and this.hasMore ? '+' }})</span></h2>
                    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
                        {% for precon in year_decks %}
                            <li>
                                <a href="{{ path('app_precon_show', {id: precon.id}) }}" class="panel group block h-full overflow-hidden transition hover:border-neon-violet/60 hover:shadow-glow">
                                    <div class="relative h-20 bg-ink-800 sm:h-24">
                                        {% if precon.coverUri %}
                                            <img src="{{ precon.coverUri }}" alt="" loading="lazy" class="h-full w-full object-cover opacity-80 transition group-hover:opacity-100">
                                        {% endif %}
                                        <div class="absolute inset-0 bg-gradient-to-t from-ink-850 to-transparent"></div>
                                        <span class="badge absolute left-2 top-2 border-white/20 bg-ink-950/60 px-1.5 py-0 text-[0.65rem] text-white">{{ precon.releasedAt|format_date('medium', locale: 'fr') }}</span>
                                    {% if owned[precon.id] is defined %}
                                        <span class="badge absolute right-2 top-2 px-1.5 py-0 text-[0.65rem] {{ owned[precon.id] == 100 ? 'border-mana-g/50 bg-ink-950/70 text-mana-g' : 'border-white/20 bg-ink-950/60 text-white' }}" title="Part du deck dans tes collections">{{ owned[precon.id] }} %</span>
                                    {% endif %}
                                    </div>
                                    <div class="p-3">
                                        <p class="line-clamp-2 font-display text-sm font-bold leading-tight text-white group-hover:text-neon-cyan">{{ precon.name }}</p>
                                        {% if precon.commanderNames %}<p class="mt-1 truncate text-xs text-ink-300">{{ precon.commanderNames }}</p>{% endif %}
                                        <p class="mt-1.5 flex items-center gap-1 text-[0.7rem] text-ink-500">
                                            {% if precon.set and precon.set.iconSvgUri %}<img src="{{ precon.set.iconSvgUri }}" alt="" class="h-3 w-3 shrink-0 invert" loading="lazy">{% endif %}
                                            <span class="truncate">{{ precon.set ? precon.set.name : precon.setCode|upper }}</span>
                                        </p>
                                    </div>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endfor %}

            {% if this.hasMore %}
                <div class="mt-8 text-center">
                    <button type="button" class="btn btn-ghost" data-action="live#action" data-live-action-param="more">Voir plus</button>
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
