{# Ajout de l'impression affichée à une collection (dans la fiche carte, rendu en différé) #}
<div {{ attributes.defaults({class: 'mt-4 rounded-xl border border-ink-800 bg-ink-900/60 p-3 text-sm'}) }}>
    {% if not app.user %}
        <p class="text-ink-300">
            <a href="{{ path('app_login') }}" data-turbo-frame="_top" class="font-semibold text-neon-cyan hover:underline">Connecte-toi</a>
            pour ajouter cette carte à ta collection.
        </p>
    {% else %}
        {% set printing = this.printing %}
        {% set selected = this.selectedCollectionId %}
        <p class="mb-2 font-semibold uppercase tracking-widest text-ink-300 text-xs">Ajouter à une collection</p>

        <form data-action="live#action:prevent" data-live-action-param="add" class="space-y-2">
            <select class="input py-1.5 text-sm" data-model="collectionId" aria-label="Collection">
                {% for collection in this.collections %}
                    <option value="{{ collection.id }}" {{ collection.id == selected ? 'selected' }}>{{ collection.name }}</option>
                {% endfor %}
                <option value="0" {{ selected == 0 ? 'selected' }}>+ Nouvelle collection…</option>
            </select>
            {% if selected == 0 %}
                <input type="text" class="input py-1.5 text-sm" data-model="norender|newName" maxlength="100" placeholder="Nom de la nouvelle collection" aria-label="Nom de la nouvelle collection">
            {% endif %}
            <div class="flex flex-wrap items-center gap-3">
                <input type="number" min="1" max="999" class="input w-20 py-1.5 text-sm" data-model="norender|quantity" aria-label="Quantité">
                {% if printing.foilOnly %}
                    <span class="badge">Foil uniquement</span>
                {% elseif printing.hasFoil %}
                    <label class="flex items-center gap-2 text-ink-100">
                        <input type="checkbox" class="h-4 w-4 accent-neon-violet" data-model="norender|foil"> Foil
                    </label>
                {% endif %}
                <button type="submit" class="btn btn-primary ml-auto px-3 py-1.5 text-xs">
                    <span data-loading="hide">Ajouter</span><span data-loading="show" hidden>…</span>
                </button>
            </div>
        </form>

        {% if error %}<p class="mt-2 text-mana-r">{{ error }}</p>{% endif %}
        {% if confirmation %}<p class="mt-2 text-mana-g" role="status">✓ {{ confirmation }}</p>{% endif %}

        {% set owned = this.ownedCopies %}
        {% if owned is not empty %}
            <p class="mt-2 text-xs text-ink-500">
                Déjà possédée :
                {% for copy in owned %}
                    <a href="{{ path('app_collection_show', {id: copy.id}) }}" data-turbo-frame="_top" class="text-ink-300 hover:text-neon-cyan">{{ copy.quantity }} × {{ copy.name }}</a>{{ not loop.last ? ' · ' }}
                {% endfor %}
            </p>
        {% endif %}
    {% endif %}
</div>
