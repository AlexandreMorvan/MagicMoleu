{% set deck = this.deck %}
<div {{ attributes.defaults({class: 'grid gap-6 lg:grid-cols-[1fr_20rem]'}) }}>
    <div class="space-y-4">
        {# ---------- Ajout de cartes ---------- #}
        <section class="panel p-4 sm:p-5">
            <label for="deck-search" class="label">Ajouter une carte</label>
            <div class="relative">
                <input id="deck-search" type="search" autocomplete="off" class="input pr-10" data-model="debounce(250)|query" placeholder="Nom anglais ou français…">
                <span data-loading class="absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 animate-spin rounded-full border-2 border-neon-violet border-t-transparent" hidden></span>
            </div>

            {% set suggestions = this.suggestions %}
            {% if suggestions is not empty %}
                <ul class="mt-3 divide-y divide-ink-800 rounded-xl border border-ink-800">
                    {% for card in suggestions %}
                        {% set fr = card.localization('fr') %}
                        <li class="flex items-center gap-3 px-3 py-2 text-sm">
                            {% if card.artCropUri %}<img src="{{ card.artCropUri }}" alt="" class="h-8 w-11 shrink-0 rounded object-cover" loading="lazy">{% endif %}
                            <a href="{{ path('app_card_show', {id: card.id}) }}" data-turbo-frame="card_modal" class="min-w-0 flex-1 truncate hover:text-neon-cyan">
                                <span class="font-semibold text-white">{{ card.name }}</span>
                                {% if fr and fr.printedName != card.name %}<span class="text-ink-500"> · {{ fr.printedName }}</span>{% endif %}
                                <span class="block truncate text-xs text-ink-500">{{ card.typeLine }}</span>
                            </a>
                            <span class="hidden shrink-0 text-xs sm:inline">{{ card.manaCost|mana_symbols }}</span>
                            <span class="flex shrink-0 gap-1">
                                {% for zone in this.zones %}
                                    {% if zone.value != 'commander' or card.canBeCommander %}
                                        <button type="button" class="btn {{ zone.value == 'main' ? 'btn-primary' : 'btn-ghost' }} px-2 py-1 text-[0.65rem]"
                                                title="Ajouter : {{ zone.label }}"
                                                data-action="live#action" data-live-action-param="add" data-live-card-id-param="{{ card.id }}" data-live-zone-param="{{ zone.value }}">
                                            + {{ zone.value == 'main' ? 'Deck' : zone.label|slice(0, 4) }}
                                        </button>
                                    {% endif %}
                                {% endfor %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% elseif query|trim|length >= 2 %}
                <p class="mt-3 text-sm text-ink-500">Aucune carte trouvée.</p>
            {% endif %}
        </section>

        {# ---------- Contenu du deck ---------- #}
        <div data-loading="addClass(opacity-60)" class="space-y-4 transition-opacity">
            {{ include('deck/_card_list.html.twig', {zones: this.zones, editable: true}) }}
        </div>
    </div>

    <aside>{{ include('deck/_sidebar.html.twig') }}</aside>
</div>
