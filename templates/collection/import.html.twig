{% extends 'base.html.twig' %}

{% block title %}Importer une collection{% endblock %}

{% block body %}
    <div class="mx-auto max-w-2xl">
        <h1 class="text-3xl uppercase">Importer une collection</h1>
        <p class="mt-2 text-ink-300">Depuis un fichier CSV exporté par l'application <strong class="text-white">ManaBox</strong>.</p>

        <section class="panel mt-6 p-5 text-sm">
            <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-ink-500">Exporter depuis ManaBox</h2>
            <ol class="mt-3 list-decimal space-y-1 pl-5 text-ink-100">
                <li>Dans ManaBox, ouvre l'onglet <strong>Collection</strong> (ou le classeur à exporter).</li>
                <li>Touche le menu <strong>⋯</strong> puis <strong>Exporter</strong>, et choisis le format <strong>CSV</strong>.</li>
                <li>Enregistre le fichier, puis envoie-le ci-dessous.</li>
            </ol>
            <p class="mt-3 text-ink-300">
                Chaque carte retrouve son impression exacte (édition, numéro), avec sa langue, son état, la finition foil,
                le prix et la date d'achat. Une carte dont l'édition n'existe pas ici est rattachée à une autre impression, et le bilan te le signale.
            </p>
        </section>

        {{ form_start(form, {attr: {class: 'panel mt-6 p-6 sm:p-8', novalidate: 'novalidate'}}) }}
            {{ form_row(form.file) }}
            {{ form_row(form.collection) }}
            {{ form_row(form.name, {help: 'Uniquement pour une nouvelle collection ; par défaut « Import ManaBox du jj/mm/aaaa ».'}) }}
            <div class="mb-5 flex items-start gap-2 text-sm text-ink-300">
                {{ form_widget(form.replace) }} {{ form_label(form.replace, null, {label_attr: {class: 'normal-case tracking-normal text-sm font-sans font-normal text-ink-300 mb-0'}}) }}
            </div>
            <div class="flex flex-wrap gap-3">
                <button type="submit" class="btn btn-primary">Importer</button>
                <a href="{{ path('app_collection_index') }}" class="btn btn-ghost">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
