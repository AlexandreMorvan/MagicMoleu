{# Vignette d'édition cliquable, avec l'illustration de sa carte emblématique en fond. Variables : set, count (optionnel) #}
{% set upcoming = set.releasedAt and set.releasedAt > date('today') %}
<a href="{{ path('app_set_show', {code: set.code}) }}"
   class="panel group relative flex h-full min-h-44 flex-col items-center justify-end overflow-hidden p-5 text-center transition hover:border-neon-violet/60 hover:shadow-glow"
   {% if set.coverCardName %}title="{{ set.name }} — illustration : {{ set.coverCardName }}"{% endif %}>
    {% if set.coverArtUri %}
        <img src="{{ set.coverArtUri }}" alt="" loading="lazy"
             class="absolute inset-0 h-full w-full object-cover opacity-45 transition duration-500 group-hover:scale-110 group-hover:opacity-70">
        <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/70 to-ink-950/10"></div>
    {% endif %}

    <div class="relative flex w-full flex-col items-center">
        {% if set.logoPath %}
            {# Le logo (titre stylisé) remplace l'icône et le nom #}
            <img src="{{ asset(set.logoPath) }}" alt="{{ set.name }}" loading="lazy"
                 class="h-16 w-full object-contain drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)] transition group-hover:scale-105">
        {% else %}
            {% if set.iconSvgUri %}
                <img src="{{ set.iconSvgUri }}" alt="" class="h-10 w-10 invert drop-shadow-[0_2px_6px_rgba(0,0,0,0.9)] transition group-hover:scale-110" loading="lazy">
            {% endif %}
            <p class="mt-3 line-clamp-2 text-sm font-semibold text-white drop-shadow-[0_1px_3px_rgba(0,0,0,0.9)] group-hover:text-neon-cyan">{{ set.name }}</p>
        {% endif %}
        <p class="mt-1 text-xs uppercase tracking-widest {{ upcoming ? 'text-neon-cyan' : 'text-ink-300' }}">
            {{ set.code }}{% if set.releasedAt %} · {{ set.releasedAt|date('m/Y') }}{% endif %}
        </p>
        {% if count is defined and count %}<p class="mt-1 text-xs text-ink-300">{{ count }} cartes</p>{% endif %}
    </div>
</a>
