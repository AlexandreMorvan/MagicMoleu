{% extends 'base.html.twig' %}

{% block title %}{{ set.name }}{% endblock %}

{% block body %}
    {% set upcoming = set.releasedAt and set.releasedAt > date('today') %}
    <header class="panel mb-8 flex flex-wrap items-center gap-6 p-6 sm:p-8">
        {% if set.iconSvgUri %}
            <img src="{{ set.iconSvgUri }}" alt="" class="h-16 w-16 shrink-0 invert drop-shadow-[0_0_12px_rgba(139,92,246,0.6)]">
        {% endif %}
        <div class="min-w-0 flex-1">
            <p class="flex flex-wrap gap-2">
                <span class="badge">{{ set.code|upper }}</span>
                <span class="badge">{{ set.setType|replace({'_': ' '})|capitalize }}</span>
                {% if upcoming %}<span class="badge border-neon-cyan/50 text-neon-cyan">À venir</span>{% endif %}
            </p>
            <h1 class="mt-3 text-3xl uppercase sm:text-4xl">{{ set.name }}</h1>
            <p class="mt-1 text-ink-300">
                {% if set.releasedAt %}{{ upcoming ? 'Sortie prévue le' : 'Sortie le' }} {{ set.releasedAt|format_date('long', locale: 'fr') }}{% endif %}
                {% if parent %} · Rattachée à <a href="{{ path('app_set_show', {code: parent.code}) }}" class="text-neon-cyan hover:underline">{{ parent.name }}</a>{% endif %}
            </p>
        </div>
        <a href="{{ path('app_set_index') }}" class="btn btn-ghost">← Toutes les éditions</a>
    </header>

    <twig:SetCards :set="set" />
{% endblock %}
