{# Un combo Commander Spellbook.
   Variables : combo, local_cards (cartes présentes en base, par identifiant oracle),
   highlighted (noms des cartes à mettre en avant), missing (noms des cartes absentes du deck), compact (déroulé replié) #}
{% set highlighted = highlighted|default([]) %}
{% set missing = missing|default([]) %}
{% set compact = compact|default(false) %}
{% set embedded = embedded|default(false) %}
<li class="{{ embedded ? '' : 'panel p-5 sm:p-6' }}" {% if not embedded %}id="combo-{{ combo.id }}"{% endif %}>
    <div class="flex flex-wrap items-start justify-between gap-3">
        <ul class="flex flex-wrap gap-2" aria-label="Résultats">
            {% for result in combo.results %}<li class="badge">{{ result }}</li>{% endfor %}
        </ul>
        <span class="text-lg" title="Identité couleur">{{ combo.identity|split('')|map(c => '{' ~ c ~ '}')|join|mana_symbols }}</span>
    </div>

    <ul class="mt-4 grid grid-cols-3 gap-3 sm:grid-cols-4 lg:grid-cols-6" aria-label="Cartes">
        {% for combo_card in combo.cards %}
            {% set local = combo_card.oracleId ? local_cards[combo_card.oracleId.toRfc4122] ?? null : null %}
            {% set local_fr = local ? local.localization('fr') : null %}
            {% set is_missing = combo_card.name in missing %}
            <li class="min-w-0">
                {% if local %}<a href="{{ path('app_card_show', {id: local.id}) }}" data-turbo-frame="card_modal" class="group block">{% else %}<div>{% endif %}
                    <div class="card-tile relative aspect-[63/88] {{ combo_card.name in highlighted ? 'ring-2 ring-neon-violet' }} {{ is_missing ? 'outline-2 outline-offset-2 outline-dashed outline-amber-400' }}">
                        {% if combo_card.imageUri %}
                            <img src="{{ combo_card.imageUri }}" alt="{{ combo_card.name }}" loading="lazy" class="h-full w-full object-cover {{ is_missing ? 'opacity-60' }}">
                        {% else %}
                            <div class="grid h-full place-items-center p-2 text-center text-xs text-ink-300">{{ combo_card.name }}</div>
                        {% endif %}
                        {% if is_missing %}<span class="badge absolute inset-x-1 bottom-1 justify-center border-amber-400/60 bg-ink-950/90 text-amber-300">À ajouter</span>{% endif %}
                    </div>
                    <p class="mt-1 truncate text-xs font-semibold text-white {{ local ? 'group-hover:text-neon-cyan' }}">{{ local_fr and local_fr.printedName ? local_fr.printedName : combo_card.name }}</p>
                {% if local %}</a>{% else %}</div>{% endif %}
            </li>
        {% endfor %}
    </ul>

    {% if compact %}<details class="mt-4"><summary class="cursor-pointer text-sm font-semibold text-neon-cyan hover:underline">Prérequis et déroulé</summary>{% endif %}
    {% if combo.prerequisites %}
        <h2 class="mt-5 text-sm uppercase tracking-widest text-ink-300">Prérequis</h2>
        <p class="mt-1 text-sm leading-relaxed">{{ combo.prerequisites|mana_symbols }}</p>
    {% endif %}

    {% if combo.steps is not empty %}
        <h2 class="mt-5 text-sm uppercase tracking-widest text-ink-300">Déroulé</h2>
        <ol class="mt-1 list-decimal space-y-1 pl-5 text-sm leading-relaxed">
            {% for step in combo.steps %}<li>{{ step|mana_symbols }}</li>{% endfor %}
        </ol>
    {% endif %}

    {% if compact %}</details>{% endif %}

    <div class="mt-5 flex flex-wrap items-center justify-between gap-3 text-sm text-ink-300">
        <span>
            {% if combo.manaNeeded %}Mana nécessaire : {{ combo.manaNeeded|mana_symbols }} · {% endif %}
            Joué dans {{ combo.popularity|format_number(locale: 'fr') }} decks
        </span>
        <a href="{{ combo.url }}" target="_blank" rel="noopener" class="text-neon-cyan hover:underline">Détails sur Commander Spellbook ↗</a>
    </div>
</li>
