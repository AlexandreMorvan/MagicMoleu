{% extends 'base.html.twig' %}

{% block title %}Combos avec {{ card.name }}{% endblock %}

{% block body %}
    {% set fr = card.localization('fr') %}
    <header class="panel mb-8 flex flex-wrap items-center gap-6 p-6 sm:p-8">
        {% if card.artCropUri %}
            <img src="{{ card.artCropUri }}" alt="" class="hidden h-20 w-28 shrink-0 rounded-lg object-cover sm:block">
        {% endif %}
        <div class="min-w-0 flex-1">
            <p class="text-sm uppercase tracking-widest text-ink-300">Combos avec</p>
            <h1 class="text-3xl leading-tight sm:text-4xl">{{ card.name }}</h1>
            {% if fr and fr.printedName != card.name %}<p class="text-ink-300">{{ fr.printedName }}</p>{% endif %}
            {% if combos %}
                <p class="mt-1 text-ink-300">
                    {% if combos.hasMore %}Les {{ combos.combos|length }} combos les plus joués{% else %}{{ combos.combos|length }} combo{{ combos.combos|length > 1 ? 's' }}{% endif %},
                    d'après <a href="{{ combos.searchUrl }}" target="_blank" rel="noopener" class="text-neon-cyan hover:underline">Commander Spellbook ↗</a>
                </p>
            {% endif %}
        </div>
        <a href="{{ path('app_card_show', {id: card.id}) }}" class="btn btn-ghost">← Fiche de la carte</a>
    </header>

    {% if combos is null %}
        <p class="panel p-6 text-ink-300">Commander Spellbook est momentanément indisponible, réessayez dans quelques instants.</p>
    {% elseif combos.combos is empty %}
        <p class="panel p-6 text-ink-300">Aucun combo connu avec cette carte.</p>
    {% else %}
        <ul class="space-y-6">
            {% for combo in combos.combos %}
                {{ include('card/_combo.html.twig', {highlighted: [card.name]}) }}
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
