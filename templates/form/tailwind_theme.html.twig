{% use 'form_div_layout.html.twig' %}

{%- block form_row -%}
    <div class="mb-5">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row -%}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' label')|trim}) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_widget_simple -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' input' ~ (errors|length ? ' input-error'))|trim}) -%}
    {{- parent() -}}
{%- endblock form_widget_simple -%}

{%- block textarea_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' input' ~ (errors|length ? ' input-error'))|trim}) -%}
    {{- parent() -}}
{%- endblock textarea_widget -%}

{%- block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' input' ~ (errors|length ? ' input-error'))|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed -%}

{# Cases à cocher / boutons radio d'un choix « expanded » : en ligne, libellé à droite #}
{%- block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }} class="flex flex-wrap gap-x-5 gap-y-2">
        {%- for child in form %}
            <label class="flex cursor-pointer items-center gap-2 text-sm text-ink-100">
                {{- form_widget(child) -}}
                {{- child.vars.label -}}
            </label>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}

{%- block radio_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' h-4 w-4 border-ink-700 bg-ink-900 accent-neon-violet')|trim}) -%}
    {{- parent() -}}
{%- endblock radio_widget -%}

{# Case à cocher seule : libellé à droite, sur la même ligne #}
{%- block checkbox_row -%}
    <div class="mb-5">
        <label class="flex cursor-pointer items-center gap-2 text-sm text-ink-100">
            {{- form_widget(form) -}}
            {{- label -}}
        </label>
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row -%}

{%- block checkbox_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' h-4 w-4 rounded border-ink-700 bg-ink-900 accent-neon-violet')|trim}) -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{%- block form_help -%}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" class="mt-1 text-xs text-ink-500">{{ help|trans(help_translation_parameters, translation_domain) }}</p>
    {%- endif -%}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- for error in errors -%}
        <p class="form-error">{{ error.message }}</p>
    {%- endfor -%}
{%- endblock form_errors -%}
