{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Synchronisation Scryfall{% endblock %}

{% block main %}
    {% if running %}
        <div class="alert alert-info">
            <i class="fa fa-spinner fa-spin"></i> Un import Scryfall est en cours.
        </div>
    {% endif %}

    <p class="text-muted">
        Les synchronisations s'exécutent en arrière-plan par le worker Messenger
        (<code>messenger:consume async scheduler_default</code>) ; elles sont aussi planifiées automatiquement.
    </p>

    <div class="row g-3">
        {% for task in tasks %}
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title"><i class="{{ task.icon }} opacity-50 me-1"></i> {{ task.label }}</h5>
                        <p class="card-text text-muted">{{ task.description }}</p>
                        {% if imported[task.value] is defined %}
                            <p class="card-text small">
                                Version importée :
                                {{ imported[task.value] ? imported[task.value]|format_datetime('short', 'short', locale: 'fr') : 'jamais' }}
                            </p>
                        {% endif %}
                        <form method="post" action="{{ path('admin_scryfall_launch', {task: task.value}) }}" class="mt-auto d-flex align-items-center gap-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('scryfall-sync') }}">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-rotate"></i> Synchroniser
                            </button>
                            {% if task.supportsForce %}
                                <label class="form-check mb-0">
                                    <input type="checkbox" name="force" value="1" class="form-check-input">
                                    <span class="form-check-label">Forcer le réimport</span>
                                </label>
                            {% endif %}
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
