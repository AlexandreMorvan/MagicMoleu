{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Tableau de bord{% endblock %}

{% block main %}
    <div class="row g-3">
        {% for stat in stats %}
            <div class="col-sm-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <i class="{{ stat.icon }} fa-2x opacity-50"></i>
                        <div>
                            <div class="fs-3 fw-bold">{{ stat.value|format_number(locale: 'fr') }}</div>
                            <div class="text-muted">{{ stat.label }}{% if stat.detail is defined %} · {{ stat.detail }}{% endif %}</div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header fw-bold">Derniers imports Scryfall</div>
                <ul class="list-group list-group-flush">
                    {% for label, date in imports %}
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ label }}</span>
                            <span class="text-muted">{{ date ? date|format_datetime('short', 'short', locale: 'fr') : 'jamais' }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header fw-bold">Derniers inscrits</div>
                <ul class="list-group list-group-flush">
                    {% for user in latest_users %}
                        <li class="list-group-item d-flex justify-content-between">
                            <span>{{ user.username }}</span>
                            <span class="text-muted">{{ user.createdAt|format_date('short', locale: 'fr') }}</span>
                        </li>
                    {% else %}
                        <li class="list-group-item text-muted">Aucun utilisateur.</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header fw-bold">Decks récemment modifiés</div>
                <ul class="list-group list-group-flush">
                    {% for deck in latest_decks %}
                        <li class="list-group-item d-flex justify-content-between">
                            <a href="{{ path('app_deck_show', {id: deck.id}) }}" target="_blank">{{ deck.name }}</a>
                            <span class="text-muted">{{ deck.owner.username }} · {{ deck.format.label }}</span>
                        </li>
                    {% else %}
                        <li class="list-group-item text-muted">Aucun deck.</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
{% endblock %}
