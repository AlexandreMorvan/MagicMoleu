{% extends 'base.html.twig' %}

{% block title %}{{ player.username }}{% endblock %}

{% block body %}
    {% set colors = player.favoriteColorList %}
    <header class="panel flex flex-col items-center gap-6 p-8 sm:flex-row sm:items-start">
        <twig:Avatar :user="player" size="h-28 w-28 text-5xl" rounded="rounded-2xl" />
        <div class="min-w-0 flex-1 text-center sm:text-left">
            <h1 class="text-3xl">{{ player.username }}</h1>
            <p class="mt-1 text-xs uppercase tracking-widest text-ink-500">Membre depuis {{ player.createdAt|format_date('long', locale: 'fr') }}</p>
            <div class="mt-3 flex flex-wrap items-center justify-center gap-2 sm:justify-start">
                {% if colors is not empty %}
                    <span class="badge flex items-center gap-1.5">
                        {% for color in colors %}{{ ('{' ~ color.value ~ '}')|mana_symbols }}{% endfor %}
                        {{ color_combination_name(player.favoriteColors) }}
                    </span>
                {% endif %}
                {% if player.preferredFormat %}<span class="badge border-neon-violet/50 text-neon-violet">{{ player.preferredFormat.label }}</span>{% endif %}
                {% if player.avatarCard %}<span class="badge text-ink-300">Avatar : {{ player.avatarCard.name }}</span>{% endif %}
            </div>
            {% if player.bio %}<p class="mt-4 max-w-2xl text-ink-100">{{ player.bio|nl2br }}</p>{% endif %}
        </div>
        {% if app.user and app.user.id == player.id %}
            <a href="{{ path('app_account') }}#profil" class="btn btn-ghost">Modifier mon profil</a>
        {% endif %}
    </header>

    <section class="mt-10">
        <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-2xl uppercase">Succès</h2>
            <p class="text-sm text-ink-300">{{ achievements|length }} / {{ total_achievements }} débloqués</p>
        </div>
        {% if achievements is empty %}
            <p class="mt-4 text-ink-500">Aucun succès débloqué pour l'instant.</p>
        {% else %}
            <ul class="mt-4 flex flex-wrap gap-3">
                {% for achievement in achievements %}
                    <li class="panel flex items-center gap-3 px-3 py-2" title="{{ achievement.description }} — débloqué le {{ unlocked[achievement.value].unlockedAt|format_date('long', locale: 'fr') }}">
                        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg ring-1 ring-white/15 rarity-{{ achievement.rarity.value }}">
                            <span class="flex flex-wrap items-center justify-center gap-px [&_.mana-symbol]:h-3.5 [&_.mana-symbol]:w-3.5">{{ achievement.symbol|mana_symbols }}</span>
                        </span>
                        <span class="text-sm font-semibold text-white">{{ achievement.label }}</span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="mt-10">
        <h2 class="text-2xl uppercase">Decks publics</h2>
        {% if decks is empty %}
            <p class="mt-4 text-ink-500">Aucun deck public.</p>
        {% else %}
            <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {% for deck in decks %}{{ include('deck/_deck_card.html.twig', {show_owner: false}) }}{% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
