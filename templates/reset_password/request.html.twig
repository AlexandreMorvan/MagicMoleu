{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    <div class="mx-auto max-w-md">
        <h1 class="text-3xl uppercase">Mot de passe oublié</h1>
        <p class="mt-1 text-ink-300">Indique l'email de ton compte : nous t'enverrons un lien pour choisir un nouveau mot de passe.</p>

        {{ form_start(form, {attr: {class: 'panel mt-8 p-6 sm:p-8', novalidate: 'novalidate'}}) }}
            {{ form_row(form.email) }}
            <button type="submit" class="btn btn-primary w-full">Envoyer le lien</button>
        {{ form_end(form) }}

        <p class="mt-6 text-center text-sm text-ink-300">
            <a href="{{ path('app_login') }}" class="font-semibold text-neon-cyan hover:underline">Retour à la connexion</a>
        </p>
    </div>
{% endblock %}
