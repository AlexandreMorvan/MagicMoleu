{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    {% set user = app.user %}
    <div class="panel flex flex-col items-center gap-6 p-8 sm:flex-row">
        <twig:Avatar :user="user" size="h-20 w-20 text-4xl" rounded="rounded-2xl" />
        <div class="text-center sm:text-left">
            <h1 class="text-3xl">{{ user.username }}</h1>
            <p class="text-ink-300">{{ user.email }}</p>
            <p class="mt-1 text-xs uppercase tracking-widest text-ink-500">Membre depuis {{ user.createdAt|format_date('long', locale: 'fr') }}</p>
        </div>
        <div class="flex flex-wrap gap-2 sm:ml-auto">
            <a href="{{ path('app_player', {username: user.username}) }}" class="btn btn-ghost">Profil public</a>
            <a href="{{ path('app_account') }}" class="btn btn-primary">Mon compte</a>
        </div>
    </div>

    <section class="mt-10" id="succes">
        <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-2xl uppercase">Succès</h2>
            <p class="text-sm text-ink-300">{{ unlocked|length }} / {{ achievements|length }} débloqués</p>
        </div>
        <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-ink-800">
            <div class="h-full rounded-full bg-gradient-to-r from-neon-violet to-neon-cyan" style="width: {{ (unlocked|length / achievements|length * 100)|round }}%"></div>
        </div>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {% for achievement in achievements %}
                {% set entry = unlocked[achievement.value] ?? null %}
                <li class="panel flex items-center gap-4 p-4 {{ entry ? '' : 'opacity-50' }}">
                    <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl ring-1 ring-white/15 {{ entry ? 'rarity-' ~ achievement.rarity.value ~ ' shadow-glow' : 'bg-ink-800 grayscale' }}">
                        <span class="flex flex-wrap items-center justify-center gap-px {{ achievement.symbol|split('{')|length > 3 ? '[&_.mana-symbol]:h-3 [&_.mana-symbol]:w-3' : '[&_.mana-symbol]:h-5 [&_.mana-symbol]:w-5' }}">{{ achievement.symbol|mana_symbols }}</span>
                    </span>
                    <div class="min-w-0">
                        <p class="font-display font-bold text-white">{{ achievement.label }}</p>
                        <p class="text-sm text-ink-300">{{ achievement.description }}</p>
                        <p class="mt-0.5 text-xs {{ entry ? 'text-neon-cyan' : 'text-ink-500' }}">
                            {{ entry ? 'Débloqué le ' ~ entry.unlockedAt|format_date('long', locale: 'fr') : achievement.rarity.label ~ ' · à débloquer' }}
                        </p>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </section>

    <section class="mt-10">
        <div class="flex items-center justify-between gap-4">
            <h2 class="text-2xl uppercase">Mes decks</h2>
            <a href="{{ path('app_deck_new') }}" class="btn btn-primary">+ Nouveau deck</a>
        </div>
        {% if decks is empty %}
            <div class="panel mt-4 border-dashed p-10 text-center text-ink-300">Aucun deck pour l'instant.</div>
        {% else %}
            <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {% for deck in decks %}{{ include('deck/_deck_card.html.twig', {show_owner: false}) }}{% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}
