{% extends 'base.html.twig' %}

{% block title %}Mon compte{% endblock %}

{% set sections = {identite: 'Identité', avatar: 'Avatar', profil: 'Profil public', 'mot-de-passe': 'Mot de passe', preferences: 'Préférences', donnees: 'Mes données'} %}

{% block body %}
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <twig:Avatar :user="app.user" size="h-14 w-14 text-2xl" rounded="rounded-2xl" />
            <div>
                <h1 class="text-3xl uppercase">Mon compte</h1>
                <p class="text-sm text-ink-300">{{ app.user.username }} · {{ app.user.email }}</p>
            </div>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="{{ path('app_player', {username: app.user.username}) }}" class="btn btn-ghost">Voir mon profil public</a>
            <a href="{{ path('app_profile') }}" class="btn btn-ghost">Mes succès</a>
        </div>
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-[12rem_1fr]">
        <nav class="hidden lg:block" aria-label="Sections du compte">
            <ul class="sticky top-24 space-y-1 text-sm">
                {% for anchor, label in sections %}
                    <li><a href="#{{ anchor }}" class="block rounded-md px-3 py-1.5 text-ink-300 hover:bg-ink-800 hover:text-white">{{ label }}</a></li>
                {% endfor %}
                <li><a href="#suppression" class="block rounded-md px-3 py-1.5 text-mana-r/80 hover:bg-ink-800 hover:text-mana-r">Supprimer le compte</a></li>
            </ul>
        </nav>

        <div class="min-w-0 space-y-6">
            <section id="identite" class="panel scroll-mt-24 p-6">
                <h2 class="text-xl uppercase">Identité</h2>
                {{ form_start(identity, {attr: {class: 'mt-4 max-w-lg', novalidate: 'novalidate'}}) }}
                    {{ form_row(identity.username) }}
                    {{ form_row(identity.email) }}
                    {{ form_row(identity.currentPassword, {help: 'Nécessaire pour modifier ton email.'}) }}
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                {{ form_end(identity) }}
            </section>

            <section id="avatar" class="panel scroll-mt-24 p-6">
                <h2 class="text-xl uppercase">Avatar</h2>
                <p class="mt-1 text-sm text-ink-300">Choisis un planeswalker : son illustration t'accompagne dans le menu, sur ton profil et sur tes decks.</p>
                <twig:AvatarPicker />
            </section>

            <section id="profil" class="panel scroll-mt-24 p-6">
                <h2 class="text-xl uppercase">Profil public</h2>
                {{ form_start(profile, {attr: {class: 'mt-4 max-w-2xl', novalidate: 'novalidate'}}) }}
                    {{ form_row(profile.bio) }}
                    <div class="mb-5">
                        {{ form_label(profile.favoriteColorList) }}
                        <div class="flex flex-wrap gap-2" role="group" aria-label="Couleurs favorites">
                            {% for child in profile.favoriteColorList %}
                                <label class="cursor-pointer" title="{{ child.vars.label }}">
                                    {{ form_widget(child, {attr: {class: 'peer sr-only'}}) }}
                                    <span class="grid h-10 w-10 place-items-center rounded-full border border-ink-700 bg-ink-900 opacity-50 grayscale transition hover:opacity-80 peer-checked:border-neon-violet peer-checked:opacity-100 peer-checked:shadow-glow peer-checked:grayscale-0 peer-focus-visible:outline-2 peer-focus-visible:outline-neon-cyan">
                                        <img src="https://svgs.scryfall.io/card-symbols/{{ child.vars.value }}.svg" alt="{{ child.vars.label }}" class="h-[65%] w-[65%]">
                                    </span>
                                </label>
                            {% endfor %}
                        </div>
                        {{ form_help(profile.favoriteColorList) }}
                    </div>
                    {{ form_row(profile.preferredFormat) }}
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                {{ form_end(profile) }}
            </section>

            <section id="mot-de-passe" class="panel scroll-mt-24 p-6">
                <h2 class="text-xl uppercase">Mot de passe</h2>
                {{ form_start(password, {attr: {class: 'mt-4 max-w-lg', novalidate: 'novalidate'}}) }}
                    {{ form_row(password.currentPassword) }}
                    {{ form_row(password.plainPassword.first) }}
                    {{ form_row(password.plainPassword.second) }}
                    <button type="submit" class="btn btn-primary">Changer le mot de passe</button>
                {{ form_end(password) }}
            </section>

            <section id="preferences" class="panel scroll-mt-24 p-6">
                <h2 class="text-xl uppercase">Préférences</h2>
                {{ form_start(preferences, {attr: {class: 'mt-4', novalidate: 'novalidate'}}) }}
                    {{ form_row(preferences.notificationToasts) }}
                    {{ form_row(preferences.defaultDeckView) }}
                    {{ form_row(preferences.defaultCollectionView) }}
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                {{ form_end(preferences) }}
            </section>

            <section id="donnees" class="panel scroll-mt-24 p-6">
                <h2 class="text-xl uppercase">Mes données</h2>
                <p class="mt-1 text-sm text-ink-300">Télécharge toutes les données de ton compte (profil, decks, collections, succès) au format JSON.</p>
                <a href="{{ path('app_account_export') }}" class="btn btn-ghost mt-4" data-turbo="false">Exporter mes données</a>
            </section>

            <section id="suppression" class="panel scroll-mt-24 border-mana-r/40 p-6">
                <h2 class="text-xl uppercase text-mana-r">Supprimer le compte</h2>
                <p class="mt-1 text-sm text-ink-300">Tes decks, collections, succès et notifications seront définitivement effacés. Pense à exporter tes données avant.</p>
                {{ form_start(delete, {attr: {
                    class: 'mt-4 max-w-lg',
                    novalidate: 'novalidate',
                    'data-turbo-confirm': 'Supprimer ton compte « ' ~ app.user.username ~ ' » ?',
                    'data-confirm-text': 'Tes decks, collections et succès seront effacés. Cette action est définitive.',
                    'data-confirm-button': 'Supprimer mon compte',
                }}) }}
                    {{ form_row(delete.password, {help: 'Confirme avec ton mot de passe.'}) }}
                    <button type="submit" class="btn border border-mana-r/60 text-mana-r hover:bg-mana-r/15">Supprimer mon compte</button>
                {{ form_end(delete) }}
            </section>
        </div>
    </div>
{% endblock %}
