{# Liste des cartes d'un deck par zone puis par catégorie.
   Variables : deck, zones, editable (boutons d'édition, dans le composant DeckEditor) #}
{% for zone in zones %}
    {% set groups = deck_groups(deck, zone) %}
    {% if groups is not empty or (editable and zone.value in ['main', 'commander']) %}
        <section class="panel p-4 sm:p-5">
            <h2 class="flex items-baseline gap-2 text-lg uppercase">
                {{ zone.label }}
                <span class="font-sans text-sm font-normal text-ink-500">{{ deck.countIn(zone) }}</span>
            </h2>

            {% if groups is empty %}
                <p class="mt-3 text-sm text-ink-500">
                    {{ zone.value == 'commander' ? 'Ajoute ton commandant avec le bouton « Cmdt » des suggestions, ou déplace une carte du deck.' : 'Aucune carte pour l\'instant : utilise la recherche pour en ajouter.' }}
                </p>
            {% endif %}

            <div class="mt-3 gap-x-8 {{ editable ? '' : 'sm:columns-2' }}">
                {% for group in groups %}
                    <div class="mb-4 break-inside-avoid">
                        <h3 class="mb-1 font-sans text-xs font-semibold uppercase tracking-widest text-ink-500">{{ group.category.label }} ({{ group.count }})</h3>
                        <ul>
                            {% for deck_card in group.cards %}
                                {% set card = deck_card.oracleCard %}
                                <li class="group flex items-center gap-2 rounded-md px-1.5 py-1 text-sm hover:bg-ink-800/70">
                                    <span class="w-5 shrink-0 text-right font-semibold text-ink-300">{{ deck_card.quantity }}</span>
                                    <a href="{{ path('app_card_show', {id: card.id}) }}" data-turbo-frame="card_modal" class="min-w-0 flex-1 truncate text-ink-100 hover:text-neon-cyan">{{ card.name }}</a>
                                    <span class="shrink-0 whitespace-nowrap text-xs">{{ card.manaCost|mana_symbols }}</span>
                                    {% if editable %}
                                        <span class="flex shrink-0 items-center gap-0.5 opacity-60 transition group-hover:opacity-100 group-focus-within:opacity-100">
                                            <button type="button" class="deck-btn" title="Retirer un exemplaire" aria-label="Retirer un exemplaire de {{ card.name }}"
                                                    data-action="live#action" data-live-action-param="changeQuantity" data-live-deck-card-id-param="{{ deck_card.id }}" data-live-delta-param="-1">−</button>
                                            <button type="button" class="deck-btn" title="Ajouter un exemplaire" aria-label="Ajouter un exemplaire de {{ card.name }}"
                                                    data-action="live#action" data-live-action-param="changeQuantity" data-live-deck-card-id-param="{{ deck_card.id }}" data-live-delta-param="1">+</button>
                                            {% for target in zones|filter(z => z != zone) %}
                                                <button type="button" class="deck-btn w-auto px-1.5 text-[0.65rem] uppercase tracking-wider" title="Déplacer vers : {{ target.label }}"
                                                        data-action="live#action" data-live-action-param="move" data-live-deck-card-id-param="{{ deck_card.id }}" data-live-zone-param="{{ target.value }}">→ {{ target.label|slice(0, 4) }}</button>
                                            {% endfor %}
                                            <button type="button" class="deck-btn hover:text-mana-r" title="Retirer du deck" aria-label="Retirer {{ card.name }} du deck"
                                                    data-action="live#action" data-live-action-param="remove" data-live-deck-card-id-param="{{ deck_card.id }}">×</button>
                                        </span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}
{% endfor %}
