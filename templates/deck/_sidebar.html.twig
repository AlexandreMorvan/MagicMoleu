{# Validité et statistiques d'un deck. Variable : deck #}
{% set validation = deck_validation(deck) %}
{% set stats = deck_stats(deck) %}

<section class="panel p-5">
    {% if validation.valid %}
        <p class="flex items-center gap-2 font-display text-lg font-bold uppercase tracking-wide text-mana-g">
            <span class="grid h-6 w-6 place-items-center rounded-full bg-mana-g/20 text-sm">✓</span> Deck valide
        </p>
        <p class="mt-1 text-sm text-ink-300">Conforme aux règles du {{ deck.format.label }} et à sa ban list.</p>
    {% else %}
        <p class="flex items-center gap-2 font-display text-lg font-bold uppercase tracking-wide text-mana-r">
            <span class="grid h-6 w-6 place-items-center rounded-full bg-mana-r/20 text-sm">!</span>
            {{ validation.errors|length }} problème{{ validation.errors|length > 1 ? 's' }}
        </p>
        <ul class="mt-3 space-y-1.5 text-sm">
            {% for error in validation.errors|slice(0, 12) %}
                <li class="flex gap-2 text-ink-100"><span class="text-mana-r">•</span>{{ error }}</li>
            {% endfor %}
            {% if validation.errors|length > 12 %}
                <li class="text-ink-500">… et {{ validation.errors|length - 12 }} autre(s).</li>
            {% endif %}
        </ul>
    {% endif %}
</section>

<section class="panel mt-4 p-5">
    <dl class="grid grid-cols-3 gap-3 text-center">
        <div>
            <dt class="text-[0.65rem] uppercase tracking-widest text-ink-500">Cartes</dt>
            <dd class="font-display text-2xl font-bold text-white">{{ stats.cardCount }}</dd>
        </div>
        <div>
            <dt class="text-[0.65rem] uppercase tracking-widest text-ink-500">CMC moyen</dt>
            <dd class="font-display text-2xl font-bold text-white">{{ stats.averageCmc is not null ? stats.averageCmc|format_number({fraction_digit: 2}, locale: 'fr') : '—' }}</dd>
        </div>
        <div>
            <dt class="text-[0.65rem] uppercase tracking-widest text-ink-500">Prix</dt>
            <dd class="font-display text-2xl font-bold text-white">{{ stats.price|format_currency('EUR', {fraction_digit: 0}, locale: 'fr') }}</dd>
        </div>
    </dl>

    <h3 class="mt-6 font-sans text-xs font-semibold uppercase tracking-widest text-ink-500">Courbe de mana</h3>
    <div class="mt-2 flex h-28 items-end gap-1.5" role="img" aria-label="Courbe de mana">
        {% for cmc, count in stats.curve %}
            <div class="flex h-full flex-1 flex-col items-center justify-end gap-1">
                <span class="text-[0.65rem] text-ink-300">{{ count ?: '' }}</span>
                <div class="w-full rounded-t bg-gradient-to-t from-neon-violet to-neon-cyan" style="height: {{ (count / stats.curvePeak * 100)|round }}%"></div>
                <span class="text-[0.65rem] text-ink-500">{{ cmc }}{{ loop.last ? '+' }}</span>
            </div>
        {% endfor %}
    </div>

    {% if stats.totalPips > 0 %}
        <h3 class="mt-6 font-sans text-xs font-semibold uppercase tracking-widest text-ink-500">Symboles de mana</h3>
        <div class="mt-2 flex h-3 overflow-hidden rounded-full bg-ink-800">
            {% for color, count in stats.pips|filter(c => c > 0) %}
                <div class="bg-mana-{{ color|lower }}" style="width: {{ (count / stats.totalPips * 100)|round(1) }}%" title="{{ color }} : {{ count }}"></div>
            {% endfor %}
        </div>
        <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-ink-300">
            {% for color, count in stats.pips|filter(c => c > 0) %}
                <li>{{ ('{' ~ color ~ '}')|mana_symbols }} {{ count }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if stats.categories is not empty %}
        <h3 class="mt-6 font-sans text-xs font-semibold uppercase tracking-widest text-ink-500">Types</h3>
        <ul class="mt-2 space-y-1 text-sm">
            {% for category, count in stats.categories %}
                <li class="flex justify-between text-ink-300"><span>{{ category }}</span><span class="text-white">{{ count }}</span></li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
