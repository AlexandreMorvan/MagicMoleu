{% extends 'base.html.twig' %}

{% block title %}Main de départ · {{ deck.name }}{% endblock %}

{% block body %}
    {% set actions %}
        <a href="{{ path('app_deck_show', {id: deck.id}) }}" class="btn btn-ghost">← Retour au deck</a>
    {% endset %}
    {{ include('deck/_header.html.twig') }}

    {% if library|length < 7 %}
        <p class="panel p-6 text-ink-300">Il faut au moins 7 cartes dans le deck principal pour tirer une main.</p>
    {% else %}
        <div data-controller="goldfish" data-goldfish-deck-value="{{ library|json_encode }}" class="grid gap-6 lg:grid-cols-[1fr_16rem]">
            <section class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" class="btn btn-ghost" data-action="goldfish#deal">Nouvelle main</button>
                    <button type="button" class="btn btn-ghost" data-goldfish-target="mulliganButton" data-action="goldfish#mulligan">Mulligan</button>
                    <button type="button" class="btn btn-primary" data-goldfish-target="keepButton" data-action="goldfish#keep">Garder</button>
                    <button type="button" class="btn btn-primary" data-goldfish-target="drawButton" data-action="goldfish#draw" hidden>Piocher</button>
                </div>
                <p class="mt-4 min-h-6 text-sm text-ink-300" data-goldfish-target="instructions" aria-live="polite"></p>
                <ul class="mt-4 grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-5 xl:grid-cols-7" data-goldfish-target="hand" aria-label="Main"></ul>
            </section>

            <aside class="space-y-4">
                <section class="panel p-5">
                    <dl class="grid grid-cols-2 gap-3 text-center">
                        <div><dt class="text-[0.65rem] uppercase tracking-widest text-ink-500">Tour</dt><dd class="font-display text-2xl font-bold text-white" data-goldfish-target="turn">—</dd></div>
                        <div><dt class="text-[0.65rem] uppercase tracking-widest text-ink-500">Mulligans</dt><dd class="font-display text-2xl font-bold text-white" data-goldfish-target="mulligans">0</dd></div>
                        <div><dt class="text-[0.65rem] uppercase tracking-widest text-ink-500">En main</dt><dd class="font-display text-2xl font-bold text-white" data-goldfish-target="handCount">0</dd></div>
                        <div><dt class="text-[0.65rem] uppercase tracking-widest text-ink-500">Terrains</dt><dd class="font-display text-2xl font-bold text-white" data-goldfish-target="lands">0</dd></div>
                    </dl>
                    <p class="mt-3 text-center text-xs text-ink-500"><span data-goldfish-target="library">0</span> cartes dans la bibliothèque</p>
                </section>
                {% if commanders is not empty %}
                    <section class="panel p-5">
                        <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-ink-500">Zone de commandement</h2>
                        <ul class="mt-3 grid grid-cols-2 gap-2">
                            {% for commander in commanders %}
                                <li><img src="{{ commander.image }}" alt="{{ commander.name }}" class="aspect-[63/88] w-full rounded-[4.75%/3.5%] bg-ink-800 object-cover"></li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}
                <p class="text-xs text-ink-500">Premier mulligan gratuit (règle du multijoueur), puis une carte de plus à mettre en dessous à chaque mulligan.</p>
            </aside>
        </div>
    {% endif %}
{% endblock %}
