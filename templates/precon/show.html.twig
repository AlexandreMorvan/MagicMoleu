{% extends 'base.html.twig' %}

{% block title %}{{ precon.name }}{% endblock %}

{% block body %}
    <header class="relative mb-8 overflow-hidden rounded-2xl border border-ink-800 bg-ink-850">
        {% if precon.coverUri %}
            <img src="{{ precon.coverUri }}" alt="" class="absolute inset-0 h-full w-full object-cover opacity-30">
        {% endif %}
        <div class="absolute inset-0 bg-gradient-to-r from-ink-950 via-ink-950/80 to-transparent"></div>
        <div class="relative flex flex-wrap items-end justify-between gap-4 p-6 sm:p-8">
            <div>
                <p class="flex flex-wrap gap-2">
                    <span class="badge border-neon-violet/50 text-neon-violet">Commander · préconstruit</span>
                    <span class="badge">{{ precon.releasedAt|format_date('long', locale: 'fr') }}</span>
                </p>
                <h1 class="mt-3 text-3xl uppercase sm:text-4xl">{{ precon.name }}</h1>
                <p class="mt-1 flex items-center gap-1.5 text-sm text-ink-300">
                    {% if precon.set %}
                        {% if precon.set.iconSvgUri %}<img src="{{ precon.set.iconSvgUri }}" alt="" class="h-4 w-4 invert">{% endif %}
                        <a href="{{ path('app_set_show', {code: precon.set.code}) }}" class="hover:text-neon-cyan">{{ precon.set.name }}</a>
                    {% else %}
                        {{ precon.setCode|upper }}
                    {% endif %}
                    · {{ precon.cardCount }} cartes
                </p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a href="{{ path('app_precon_index') }}" class="btn btn-ghost">← Préconstruits</a>
                {% if app.user %}
                    <form method="post" action="{{ path('app_precon_add', {id: precon.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('add-precon') }}">
                        <button type="submit" class="btn btn-primary">+ Ajouter à mes decks</button>
                    </form>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-primary">Connecte-toi pour l'ajouter</a>
                {% endif %}
            </div>
        </div>
    </header>

    {% if precon.unresolvedCount %}
        <p class="panel mb-6 border-amber-400/40 p-4 text-sm text-amber-300">
            {{ precon.unresolvedCount }} carte{{ precon.unresolvedCount > 1 ? 's' }} de ce deck {{ precon.unresolvedCount > 1 ? 'ne sont' : 'n\'est' }} pas encore dans notre base : elle{{ precon.unresolvedCount > 1 ? 's' }} sera{{ precon.unresolvedCount > 1 ? 'ont' }} ajoutée{{ precon.unresolvedCount > 1 ? 's' }} automatiquement.
        </p>
    {% endif %}

    {% if ownership %}
        <div class="mb-8 max-w-md">{{ include('collection/_ownership.html.twig') }}</div>
    {% endif %}

    {% for section in [{title: commanders|length > 1 ? 'Commandants' : 'Commandant', cards: commanders}, {title: 'Deck', cards: main}] %}
        {% if section.cards is not empty %}
            <section class="mb-10">
                <h2 class="text-xl uppercase text-ink-300">{{ section.title }} <span class="text-ink-500">({{ section.cards|reduce((sum, c) => sum + c.quantity, 0) }})</span></h2>
                <ul class="mt-4 grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8">
                    {% for line in section.cards|sort((a, b) => a.oracleCard.name <=> b.oracleCard.name) %}
                        {% set fr = line.oracleCard.localization('fr') %}
                        <li class="min-w-0">
                            <a href="{{ path('app_card_show', line.printing ? {id: line.oracleCard.id, impression: line.printing.id} : {id: line.oracleCard.id}) }}" data-turbo-frame="card_modal" class="group block">
                                <div class="card-tile relative aspect-[63/88]">
                                    {% if line.imageUri %}
                                        <img src="{{ line.imageUri }}" alt="{{ line.oracleCard.name }}" loading="lazy" class="h-full w-full object-cover">
                                    {% else %}
                                        <div class="grid h-full place-items-center p-2 text-center text-xs text-ink-300">{{ line.oracleCard.name }}</div>
                                    {% endif %}
                                    {% if line.quantity > 1 %}<span class="badge absolute bottom-1.5 right-1.5 border-white/20 bg-ink-950/80 text-white">×{{ line.quantity }}</span>{% endif %}
                                </div>
                                <p class="mt-1 truncate text-xs font-semibold text-white group-hover:text-neon-cyan">{{ fr and fr.printedName ? fr.printedName : line.oracleCard.name }}</p>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    {% endfor %}
{% endblock %}
