<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{% endblock %}{{ block('title')|trim ? ' · ' }}{{ site_name }}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><path d=%22M16 2 29 16 16 30 3 16Z%22 fill=%22%238b5cf6%22/><path d=%22M16 8 23 16 16 24 9 16Z%22 fill=%22%2322d3ee%22/></svg>">
        {# Polices hébergées localement (assets/fonts) ; les deux plus utilisées sont préchargées #}
        <link rel="preload" href="{{ asset('fonts/inter-latin-wght-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/rajdhani-latin-700-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="flex min-h-screen flex-col">
        {% set route = app.current_route %}
        {% set nav_items = [
            {route: 'app_home', label: 'Accueil', active: ['app_home']},
            {route: 'app_card_search', label: 'Recherche', active: ['app_card_search', 'app_card_show']},
            {route: 'app_set_index', label: 'Éditions', active: ['app_set_index', 'app_set_show']},
            {route: 'app_deck_index', label: 'Decks', active: ['app_deck_index']},
            {route: 'app_spoilers', label: 'Spoilers', active: ['app_spoilers']},
            {route: 'app_game', label: 'Partie', active: ['app_game']},
        ]|merge(app.user ? [
            {route: 'app_collection_index', label: 'Collection', active: ['app_collection_index', 'app_collection_show', 'app_collection_new', 'app_collection_settings']},
        ] : []) %}
        <header class="sticky top-0 z-40 border-b border-ink-800 bg-ink-950/80 backdrop-blur-md">
            <nav class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-4 sm:px-6">
                <a href="{{ path('app_home') }}" class="group flex items-center gap-2">
                    <span class="grid h-8 w-8 rotate-45 place-items-center rounded-md bg-gradient-to-br from-neon-violet to-neon-cyan transition group-hover:shadow-glow">
                        <span class="h-3 w-3 rounded-sm bg-ink-950"></span>
                    </span>
                    <span class="font-display text-xl font-bold uppercase tracking-[0.2em] text-white">{{ site_name }}</span>
                </a>

                <div class="hidden items-center gap-1 md:flex">
                    {% for item in nav_items %}
                        <a href="{{ path(item.route) }}" class="nav-link {{ route in item.active ? 'nav-link-active' }}">{{ item.label }}</a>
                    {% endfor %}
                </div>

                <div class="ml-auto flex items-center gap-2">
                    {% if app.user %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('admin') }}" class="nav-link hidden sm:inline-block" data-turbo="false">Admin</a>
                        {% endif %}
                        <twig:NotificationBell />
                        {# Menu du compte #}
                        <details class="relative" data-controller="dropdown" data-action="click@window->dropdown#closeOutside keydown.esc@window->dropdown#close">
                            <summary class="nav-link {{ route in ['app_profile', 'app_account'] ? 'nav-link-active' }} flex cursor-pointer list-none items-center gap-2">
                                <twig:Avatar :user="app.user" size="h-7 w-7 text-xs" />
                                <span class="hidden sm:inline">{{ app.user.username }}</span>
                            </summary>
                            <div class="panel absolute right-0 z-50 mt-2 w-56 overflow-hidden py-1 text-sm shadow-2xl shadow-black/60">
                                <a href="{{ path('app_profile') }}" class="block px-4 py-2 text-ink-100 hover:bg-ink-800 hover:text-white">Mes succès et decks</a>
                                <a href="{{ path('app_player', {username: app.user.username}) }}" class="block px-4 py-2 text-ink-100 hover:bg-ink-800 hover:text-white">Mon profil public</a>
                                <a href="{{ path('app_account') }}" class="block px-4 py-2 text-ink-100 hover:bg-ink-800 hover:text-white">Mon compte</a>
                                <form method="post" action="{{ path('app_logout') }}" data-turbo="false" class="border-t border-ink-800">
                                    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                                    <button type="submit" class="block w-full px-4 py-2 text-left text-ink-300 hover:bg-ink-800 hover:text-white">Déconnexion</button>
                                </form>
                            </div>
                        </details>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="nav-link {{ route == 'app_login' ? 'nav-link-active' }}">Connexion</a>
                        <a href="{{ path('app_register') }}" class="btn btn-primary">Créer un compte</a>
                    {% endif %}
                </div>
            </nav>
            <div class="flex gap-1 overflow-x-auto border-t border-ink-800 px-2 md:hidden">
                {% for item in nav_items %}
                    <a href="{{ path(item.route) }}" class="nav-link shrink-0 {{ route in item.active ? 'nav-link-active' }}">{{ item.label }}</a>
                {% endfor %}
            </div>
        </header>

        {# Pas de préchargement au survol dans le contenu : les grilles de cartes déclencheraient une requête par carte survolée.
           Il reste actif sur le menu, où il accélère la navigation. #}
        <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 sm:py-12" data-turbo-prefetch="false">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="panel mb-6 border-l-4 px-4 py-3 {{ {error: 'border-l-mana-r', warning: 'border-l-amber-400'}[type] ?? 'border-l-neon-cyan' }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        {% if app.user and app.user.wantsNotificationToasts %}<twig:NotificationToasts />{% endif %}

        {# Modale de fiche carte : les liens ciblant la frame « card_modal » s'y affichent #}
        <dialog class="card-modal m-auto w-[min(64rem,calc(100vw-2rem))] max-h-[calc(100vh-2rem)] overflow-y-auto rounded-2xl border border-ink-700 bg-ink-850 p-0 text-ink-100 shadow-2xl shadow-black/60"
                aria-labelledby="card-modal-title"
                data-controller="modal"
                data-modal-version-value="{{ build_version }}"
                data-action="turbo:before-fetch-request->modal#addVersion turbo:frame-load->modal#open close->modal#clear click->modal#closeOnBackdrop">
            <div class="relative p-6 sm:p-8">
                <button type="button" class="absolute right-3 top-3 z-10 grid h-9 w-9 place-items-center rounded-full text-xl text-ink-300 transition hover:bg-ink-800 hover:text-white"
                        aria-label="Fermer" data-action="modal#close" data-modal-target="closeButton">×</button>
                <turbo-frame id="card_modal" data-modal-target="frame"></turbo-frame>
            </div>
        </dialog>

        <footer class="border-t border-ink-800 py-6 text-center text-xs leading-relaxed text-ink-500">
            <p>
                {{ site_name }} est un contenu de fan non officiel autorisé par la Fan Content Policy. Non approuvé ni sponsorisé par Wizards.
                Certaines ressources appartiennent à Wizards of the Coast. ©Wizards of the Coast LLC.
            </p>
            <p class="mt-1">Données et images de cartes fournies par <a href="https://scryfall.com" class="text-ink-300 hover:text-neon-cyan">Scryfall</a>.</p>
        </footer>
    </body>
</html>
